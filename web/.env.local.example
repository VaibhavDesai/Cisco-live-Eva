# Copy this file to .env.local and fill in the values.
# These are exposed to the browser (Vite inlines any VITE_* var at build time).

# Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to ship to the client; RLS must be enabled)
VITE_SUPABASE_ANON_KEY=

# Optional hosted companion API. When set, voice preview calls use:
#   <VITE_CHAT_API_URL without /chat>/convai/signed-url
# Example: https://your-worker.example.com/chat
VITE_CHAT_API_URL=

# Optional direct hosted signed-url endpoint for voice preview.
# Prefer this when the chat API and voice API are hosted separately.
VITE_CONVAI_SIGNED_URL_API_URL=

# Local dev proxy only. These are server-side values read by vite.config.ts;
# do not prefix them with VITE_ because they must not be exposed to the browser.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
