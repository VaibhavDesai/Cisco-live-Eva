# Copy this file to .env.local and fill in the values.
# These are exposed to the browser (Vite inlines any VITE_* var at build time).

# Supabase project URL, e.g. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe to ship to the client; RLS must be enabled)
VITE_SUPABASE_ANON_KEY=

# Optional hosted companion API. When set, companion calls use:
#   Dashboard ASR: <VITE_CHAT_API_URL without /chat>/transcribe
#   Agents ASR:    <VITE_CHAT_API_URL without /chat>/elevenlabs/transcribe
#   Voice preview: <VITE_CHAT_API_URL without /chat>/convai/signed-url
# Example: https://your-worker.example.com/chat
VITE_CHAT_API_URL=

# Optional direct hosted ElevenLabs signed-url endpoint for voice preview.
# Prefer this when the chat API and voice API are hosted separately.
VITE_CONVAI_SIGNED_URL_API_URL=

# Local dev proxy only. These are server-side values read by vite.config.ts;
# do not prefix them with VITE_ because they must not be exposed to the browser.
#
# Cisco AI chat completions. CISCO_AI_AUTH is the complete Basic authorization
# value created from the portal's client ID and client secret (for example,
# "Basic <base64(client-id:client-secret)>"). Keep it in .env or .env.local;
# never use a VITE_ prefix. CISCO_AI_APPKEY identifies this local application.
# CISCO_AI_COMPLETIONS_URL is optional when using the default Cisco deployment.
CISCO_AI_AUTH=
CISCO_AI_APPKEY=
CISCO_AI_COMPLETIONS_URL=

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
